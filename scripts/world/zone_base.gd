class_name ZoneBase
extends Node2D
## Shared plumbing for a playable zone: the generated-grid reader, the runtime
## TileSet/TileMapLayer build, exploration tracking, camera setup, walkable-tile
## scans, actor instantiation and villager schedule attachment.
##
## A concrete zone owns only its own content — the grid, the spawns, the day
## cycle wiring and the two `zone_*` identity hooks — and reaches this class by
## overriding the virtual hooks `_ready` calls in a fixed order. Nothing here
## knows anything about the forest.

const TILE := 16
## The forest palette is the default atlas; every concrete zone overrides
## `tile_atlas_path()` with its own (CRITIC-P1-01: one byte-identical floor for
## all four zones made the forest grass read as 92% of the dungeon sample).
## The variants are deterministic per-zone shifts of the original tiles.png,
## generated by tools/import_ninja_sprites.py --zone-variants.
const ATLAS_FOREST := "res://assets/sprites/tiles_forest.png"

const PLAYER_SCENE := "res://scenes/player/player.tscn"

const TILE_GRASS := 0
const TILE_DIRT := 1
const TILE_STONE := 2
const TILE_TREE := 3

## Radius (in tiles) around the player that counts as explored on the map.
const VISIT_RADIUS := 3

## The letterbox: the strip of the 480x270 viewport the world is allowed to show
## in, in viewport pixels. Everything above `HUD_BAND_TOP` and below
## `HUD_BAND_BOTTOM` is HUD frame — `hud.gd` paints two opaque full-width bands
## over exactly those strips, and the plates (status, level column, controls) sit
## INSIDE them, so no plate ever overlaps the playfield and nothing drawn under a
## band can reach the player's eyes as a 14 %-opacity blob.
##
## The two bands are the same height (55 px each), so the band centre is the
## viewport centre and the constant `CAMERA_BAND_OFFSET` below is 0: the camera's
## own follow keeps the player in the middle of the band without help.
##
## The 480x270 viewport is the one the project ships
## (`display/window/size/viewport_width|height`).
const HUD_BAND_TOP := 55.0
const HUD_BAND_BOTTOM := 215.0
## The one vertical offset the camera ever carries, set once in
## `_configure_camera()`. It is 0 because the letterbox is symmetric: the band
## centre (55 + 215) / 2 = 135 is the viewport centre, so the follow already
## centres the player in the band. A non-zero constant here would fix one border
## and break the other (the offset is applied AFTER the limit clamp, so it drags
## the view past the limit it is meant to respect), which is exactly why the old
## per-frame guard needed a clamp — see `CAMERA_BAND_MARGIN`.
const CAMERA_BAND_OFFSET := 0.0
## How far the camera limits reach PAST the map, top and bottom, so the camera can
## keep scrolling while the player walks into a wall. The limits are inset by the
## band height instead of sitting on the map edge: the camera's visible window is
## the band (160 px), so its centre may come within `HUD_BAND_TOP` of the map edge
## but no closer. With `limit_top = -55` and `limit_bottom = map_height + 55` the
## visible window is pinned inside the map on both axes, which yields the whole
## letterbox contract as a structural invariant of the engine's own clamping:
##
##   visible window = [cam − 80, cam + 80] ⊆ [0, map_height]
##   player viewport y = player_y − clamp(player_y, 80, H − 80) + 135 ∈ [55, 215]
##
## i.e. the player is never under a band, no walkable tile is ever permanently
## under a band, and the only world the bands ever hide is off-map void at a
## border. Replacing the per-frame guard this project used to run (which could
## only shift 40 px and still left roaming enemies under the plates) with limits
## costs nothing at the borders: the strip the camera shows past the map is under
## an opaque band, and the horizontal limits stay on the map edge because there
## is no band on the left or right.
const CAMERA_BAND_MARGIN := HUD_BAND_TOP

var player: Node2D
var tile_layer: TileMapLayer
var _map: Array[String] = []

## The in-game day cycle driving the villager schedules (spec §12.1). Created as
## a child node rather than an autoload so the zone owns it and a test gets it by
## instantiating the world scene. Exposed for the HUD and a test to reach.
var day_clock: DayClock

## Tiles the player has seen, keyed by Vector2i. Read-only for the map panel.
var _visited: Dictionary = {}
var _last_visited_tile := Vector2i(-9999, -9999)

## Extent of the generated grid. A zone's `_generate_map` owns these; the base
## reads them for the camera limits and the exploration bounds instead of holding
## a size of its own.
var _map_width := 0
var _map_height := 0


func _ready() -> void:
	# The fixed hook order. A zone that overrides any of them must keep this
	# sequence: content first, then the tile layer that draws it, then the actors
	# that stand on it, then the clock and the camera that watch them, then the
	# audio bed that belongs to the place the player has just arrived in.
	_advertise_zone()
	_generate_map()
	_build_tileset_and_layer()
	_spawn_actors()
	_setup_day_cycle()
	_configure_camera()
	_last_visited_tile = player_tile()
	_mark_visited(_last_visited_tile)
	_start_zone_audio()


func _process(_delta: float) -> void:
	var tile := player_tile()
	if tile == _last_visited_tile:
		return
	_last_visited_tile = tile
	_mark_visited(tile)


# --- virtual hooks -------------------------------------------------------------

## Runs before anything else, so a zone can publish itself to the groups other
## actors look up (the safe zone owner, for instance) before a single actor of
## this zone exists and while it still resolves them on its first frame.
func _advertise_zone() -> void:
	pass


func _generate_map() -> void:
	pass


## The tile atlas this zone paints its floor from. The base defaults to the
## forest palette; each concrete zone overrides this with its own per-zone
## variant so no two zones share a floor colour (spec §24 readability,
## CRITIC-P1-01). Pure data — safe to call on an unparented instance.
func tile_atlas_path() -> String:
	return ATLAS_FOREST


## Readability (CRITIC-P1-18): the silhouette outline colour an enemy sprite
## wears in THIS zone. The base is the light-floor default — a dark outline that
## separates on the forest grass; the dark zones (dungeon, fortress) override
## with a light outline so a body does not sink into dark masonry. Pure data,
## safe on an unparented instance, and read per zone by the readability test.
func enemy_outline_color() -> Color:
	return Color(0.043, 0.051, 0.067)


## Readability (CRITIC-P1-18): the body brightness scalar a type's hue is scaled
## by in THIS zone. Dark zones brighten the body (value > 1) so it clears the
## dark floor; light zones darken it (value < 1) so it clears the light floor.
## The base is the forest value; every concrete zone states its own.
func enemy_body_tint() -> Color:
	return Color(0.5, 0.5, 0.5)


## Builds the runtime TileSet from the shared atlas and paints `_map` into a new
## TileMapLayer. The character-to-tile mapping is the project-wide one, so a zone
## only overrides this when it genuinely needs a different tileset.
func _build_tileset_and_layer() -> void:
	var ts := TileSet.new()
	ts.tile_size = Vector2i(TILE, TILE)
	ts.add_physics_layer()
	ts.set_physics_layer_collision_layer(0, 1)
	ts.set_physics_layer_collision_mask(0, 0)

	var src := TileSetAtlasSource.new()
	src.texture = load(tile_atlas_path())
	src.texture_region_size = Vector2i(TILE, TILE)
	# The source has to be registered before tiles are created, otherwise the
	# created TileData does not know about the physics layer added above.
	ts.add_source(src, 0)

	for i in range(4):
		src.create_tile(Vector2i(i, 0))

	var square := PackedVector2Array([
		Vector2(-8, -8), Vector2(8, -8), Vector2(8, 8), Vector2(-8, 8)
	])
	for solid in [TILE_STONE, TILE_TREE]:
		var data := src.get_tile_data(Vector2i(solid, 0), 0)
		data.add_collision_polygon(0)
		data.set_collision_polygon_points(0, 0, square)

	tile_layer = TileMapLayer.new()
	tile_layer.name = "Ground"
	tile_layer.tile_set = ts
	tile_layer.y_sort_enabled = true
	add_child(tile_layer)

	for y in range(_map.size()):
		var row: String = _map[y]
		for x in range(row.length()):
			var ch := row[x]
			var tile := TILE_GRASS
			match ch:
				"#":
					tile = TILE_STONE
				"T":
					tile = TILE_TREE
				",":
					tile = TILE_DIRT
				_:
					tile = TILE_GRASS
			tile_layer.set_cell(Vector2i(x, y), 0, Vector2i(tile, 0))


func _spawn_actors() -> void:
	pass


func _setup_day_cycle() -> void:
	pass


func zone_id() -> String:
	return "zone"


func zone_name() -> String:
	return "Зона"


## Points of interest for the map panel. A zone answers with live node
## references rather than paths, so the panel never needs a lookup that can go
## stale.
func landmarks() -> Array[Dictionary]:
	return []


func is_in_safe_zone(_tile: Vector2i) -> bool:
	return false


## The looping music track this zone starts on build (`music_forest`, …), or ""
## for no music. A concrete zone overrides this with its own track name; the base
## stays silent so a zone that has not chosen a bed does not steal the previous
## zone's track on a travel.
func music_track() -> String:
	return ""


## The looping ambience bed this zone starts under its music (`ambience_forest`),
## or "" for none. Only the forest uses this today.
func ambience_track() -> String:
	return ""


# --- zone audio ----------------------------------------------------------------

## Starts this zone's music and ambience once the world is built. Resolved
## through the runtime autoload rather than a compile-time identifier, exactly
## like every other caller of `AudioManager`: a missing audio layer is a silent
## no-op, never a crash, and the zone still builds. `play_music` replaces whatever
## the previous zone was playing, so travel never stacks two tracks.
func _start_zone_audio() -> void:
	var audio := _audio_manager()
	if audio == null:
		return
	var track := music_track()
	if track != "" and audio.has_method("play_music"):
		audio.call("play_music", track)
	var bed := ambience_track()
	if bed != "" and audio.has_method("play_ambience"):
		audio.call("play_ambience", bed)


func _audio_manager() -> Node:
	var loop := Engine.get_main_loop() as SceneTree
	if loop == null or loop.root == null:
		return null
	return loop.root.get_node_or_null("AudioManager")


# --- public API ----------------------------------------------------------------

func map_size() -> Vector2i:
	return Vector2i(_map_width, _map_height)


func cell_at(tile: Vector2i) -> String:
	if tile.x < 0 or tile.y < 0 or tile.y >= _map.size():
		return ""
	var row: String = _map[tile.y]
	if tile.x >= row.length():
		return ""
	return row[tile.x]


func is_explored(tile: Vector2i) -> bool:
	return _visited.has(tile)


func explored_tiles() -> Array[Vector2i]:
	var out: Array[Vector2i] = []
	for key: Vector2i in _visited.keys():
		out.append(key)
	return out


func player_tile() -> Vector2i:
	if player == null:
		return Vector2i(-1, -1)
	return Vector2i(
		floori(player.global_position.x / float(TILE)),
		floori(player.global_position.y / float(TILE))
	)


# --- exploration ---------------------------------------------------------------

func _mark_visited(center: Vector2i) -> void:
	for dy in range(-VISIT_RADIUS, VISIT_RADIUS + 1):
		for dx in range(-VISIT_RADIUS, VISIT_RADIUS + 1):
			var t := Vector2i(center.x + dx, center.y + dy)
			if t.x < 0 or t.y < 0 or t.x >= _map_width or t.y >= _map_height:
				continue
			_visited[t] = true


# --- spawn helpers -------------------------------------------------------------

func _tile_center(x: int, y: int) -> Vector2:
	return Vector2(x * TILE + TILE / 2.0, y * TILE + TILE / 2.0)


## First walkable tile (grass "." or dirt ",") scanning row-major outward from
## the anchor, so a prop never spawns inside a tree cluster or a wall. Falls
## back to the anchor when nothing walkable is found in range. Deterministic:
## the scan order depends only on the fixed seed and the fixed anchor.
func _find_walkable_near(anchor: Vector2i, radius: int) -> Vector2i:
	for dy in range(-radius, radius + 1):
		for dx in range(-radius, radius + 1):
			var t := Vector2i(anchor.x + dx, anchor.y + dy)
			var ch := cell_at(t)
			if ch == "." or ch == ",":
				return t
	return anchor


## The same outward row-major scan, but a tile that lies within `min_distance`
## tiles of any point in `avoid` (Chebyshev, so the diagonal counts as close too)
## is skipped. The smith needs this where the merchant does not: the player
## interacts with the NEAREST interactable in range, and the debug bot presses E
## the moment it is within its stop tolerance of Edrik, so the forge has to sit
## outside that reach rather than merely on a free tile. Deterministic, like every
## other spawn here: the scan order depends only on the fixed seed and the anchor.
func _find_walkable_away(anchor: Vector2i, radius: int, avoid: Array[Vector2i], min_distance: int) -> Vector2i:
	for dy in range(-radius, radius + 1):
		for dx in range(-radius, radius + 1):
			var t := Vector2i(anchor.x + dx, anchor.y + dy)
			var ch := cell_at(t)
			if ch != "." and ch != ",":
				continue
			var too_close := false
			for point: Vector2i in avoid:
				if absi(t.x - point.x) < min_distance and absi(t.y - point.y) < min_distance:
					too_close = true
					break
			if not too_close:
				return t
	return anchor


func _spawn_enemy(scene_path: String, tx: int, ty: int, node_name: String) -> void:
	var e := _instantiate(scene_path, _tile_center(tx, ty), node_name)
	e.name = node_name


func _instantiate(scene_path: String, pos: Vector2, node_name: String) -> Node2D:
	var packed: PackedScene = load(scene_path)
	if packed == null:
		push_error("%s: cannot load %s" % [zone_id(), scene_path])
		return null
	var inst := packed.instantiate() as Node2D
	inst.position = pos
	add_child(inst)
	inst.name = node_name
	return inst


func _configure_camera() -> void:
	if player == null:
		return
	var cam := player.get_node_or_null("Camera2D") as Camera2D
	if cam == null:
		return
	# The letterbox: the camera's VISIBLE window is the band between the two opaque
	# HUD bands (`hud_band()`), 160 px tall, and the limits are inset by the band
	# height so that window can never leave the map. The strips the camera still
	# renders above and below it land under the opaque frame, which is the whole
	# point: no gameplay entity can be seen through a HUD plate, because no plate
	# overlaps the playfield any more. See `CAMERA_BAND_MARGIN` for the arithmetic.
	cam.limit_left = 0
	cam.limit_top = -int(CAMERA_BAND_MARGIN)
	cam.limit_right = _map_width * TILE
	cam.limit_bottom = _map_height * TILE + int(CAMERA_BAND_MARGIN)
	cam.position_smoothing_enabled = true
	cam.position_smoothing_speed = 7.0
	# The one offset the camera ever carries, written once here instead of every
	# frame: the band is symmetric, so it is 0, and the follow does the rest.
	# Seeded before the first frame is drawn so the first frame of a freshly built
	# zone already shows the player inside the band.
	cam.offset = Vector2(0.0, CAMERA_BAND_OFFSET)
	cam.make_current()


## The strip of the viewport the world is allowed to show in, in viewport
## coordinates: everything between the two opaque HUD bands. `hud.gd` paints its
## bands on exactly these edges, the camera limits are inset by the same number,
## and the letterbox test measures the live rects and the live camera against
## them, so the HUD and the camera cannot drift apart in silence.
func hud_band() -> Rect2:
	return Rect2(0.0, HUD_BAND_TOP, 480.0, HUD_BAND_BOTTOM - HUD_BAND_TOP)


## The camera's constant vertical offset, exposed so the letterbox test can assert
## the visible window is derived from a value that never changes rather than from
## whatever the camera happens to hold mid-frame.
func camera_band_offset() -> float:
	return CAMERA_BAND_OFFSET


## Gives one NPC a `ScheduleComponent` bound to this zone's clock. The clock has
## to be in the tree already so its `_ready` (which loads `data/schedules.json`
## and seeds the morning phase) runs before the component reads `phase()`.
func _attach_schedule(npc: Node2D) -> void:
	if npc == null or not is_instance_valid(npc):
		return
	var comp := ScheduleComponent.new()
	comp.name = "ScheduleComponent"
	comp.setup(npc, self, day_clock)
	npc.add_child(comp)
