{
	"dialogues": {
		"edrik_intro": {
			"speaker_id": "edrik",
			"speaker": "Эдрик",
			"start": "n1",
			"nodes": {
				"n1": {
					"text": "Слава павшим. Но живым работа нужнее.",
					"next": "n2"
				},
				"n2": {
					"text": "Волки у опушки рвут скот. Проводи их, и деревня вздохнёт.",
					"options": [
						{
							"text": "Я сделаю это.",
							"effects": [{"flag": "accepted_wolf_hunt", "value": true}],
							"next": "n3"
						},
						{
							"text": "Дай мне награду вперёд.",
							"next": "n4"
						}
					]
				},
				"n3": {
					"text": "Опушка к северу. Вернись, когда волков станет меньше.",
					"effects": [{"quest": "q01_ash_wolves", "action": "start"}],
					"next": ""
				},
				"n4": {
					"text": "Награда ждёт тех, кто принёс волчьи клыки, а не тех, кто торгуется.",
					"next": "n2"
				}
			}
		},
		"edrik_after_hunt": {
			"speaker_id": "edrik",
			"speaker": "Эдрик",
			"start": "n1",
			"condition": {"quest_done": "q01_ash_wolves"},
			"nodes": {
				"n1": {
					"text": "Деревня дышит ровнее. Спасибо.",
					"next": ""
				}
			}
		},
		"mila_intro": {
			"speaker_id": "mila",
			"speaker": "Травница Мила",
			"start": "n1",
			"nodes": {
				"n1": {
					"text": "Осторожнее, тут у меня сушится полынь. Я Мила, травница.",
					"next": "n2"
				},
				"n2": {
					"text": "Деревня теперь под защитой — зверь сюда не сунется. А вот мне нужны клыки да спокойная тропа. Вернёшься — поговорим.",
					"next": ""
				}
			}
		},
		"pilgrim_forest": {
			"speaker_id": "pilgrim",
			"speaker": "Пепельный Паломник",
			"start": "n1",
			"condition": {"not_flag": "pilgrim_met_forest"},
			"nodes": {
				"n1": {
					"text": "…Не бойся. Я тоже из пепла.",
					"next": "n2"
				},
				"n2": {
					"text": "Пепел помнит. Всё, что горело, помнит того, кто зажёг.",
					"next": "n3"
				},
				"n3": {
					"text": "Здесь дышал король. Пепел запомнил его.",
					"effects": [{"flag": "pilgrim_met_forest", "value": true}],
					"next": ""
				}
			}
		},
		"pilgrim_ruins": {
			"speaker_id": "pilgrim",
			"speaker": "Пепельный Паломник",
			"start": "n1",
			"condition": {"flag": "pilgrim_met_forest", "not_flag": "pilgrim_met_ruins"},
			"nodes": {
				"n1": {
					"text": "…Ты слышал пепел. Теперь слушай камень.",
					"next": "n2"
				},
				"n2": {
					"text": "Замок держит чужих. Чтобы не вошли.",
					"next": "n3"
				},
				"n3": {
					"text": "Печать — не замок. Печать — обещание, данное своему.",
					"effects": [{"flag": "pilgrim_met_ruins", "value": true}],
					"next": ""
				}
			}
		},
		"pilgrim_dungeon": {
			"speaker_id": "pilgrim",
			"speaker": "Пепельный Паломник",
			"start": "n1",
			"condition": {"flag": "pilgrim_met_ruins", "not_flag": "pilgrim_met_dungeon"},
			"nodes": {
				"n1": {
					"text": "…Колокол. Слышишь?",
					"next": "n2"
				},
				"n2": {
					"text": "Он звал мёртвых. Не для боя.",
					"next": "n3"
				},
				"n3": {
					"text": "Мёртвые сторожат печать. Колокол помнит их имена.",
					"effects": [{"flag": "pilgrim_met_dungeon", "value": true}],
					"next": ""
				}
			}
		},
		"pilgrim_fortress": {
			"speaker_id": "pilgrim",
			"speaker": "Пепельный Паломник",
			"start": "n1",
			"condition": {"flag": "pilgrim_met_dungeon", "not_flag": "pilgrim_met_fortress"},
			"nodes": {
				"n1": {
					"text": "…Мы дошли до начала.",
					"next": "n2"
				},
				"n2": {
					"text": "Король — и есть печать. Не заперт. Держит.",
					"next": "n3"
				},
				"n3": {
					"text": "Корона — не власть. Корона — выбор. Наденешь — останешься держать.",
					"effects": [
						{"flag": "pilgrim_met_fortress", "value": true},
						{"flag": "pilgrim_truth_known", "value": true}
					],
					"next": ""
				}
			}
		}
	}
}
